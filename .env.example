# Copy to .env at the repo root. Apps load it on startup; real environment variables win.
DATABASE_URL=postgres://localhost:5432/tricity_writer
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
# Public origin of the dashboard. Auth cookies and links are issued for it.
WEB_ORIGIN=http://localhost:3000
# Where the dashboard's server proxies /api/* (Next rewrites).
API_INTERNAL_URL=http://127.0.0.1:4000

# 32 random bytes each, base64: openssl rand -base64 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Platform-held provider keys, used by workspaces that haven't added their own (Settings → AI keys).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# true = serve every AI call from the built-in fake provider (no keys needed, no cost).
AI_FAKE=false

# Local development only: WordPress Playground runs on 127.0.0.1, which production refuses to call.
ALLOW_PRIVATE_SITE_URLS=true

# Optional: false = workspaces must bring their own AI keys (Settings → AI keys).
ALLOW_PLATFORM_KEYS=true
# Optional: USD each account may spend per month through the platform keys, shared by the workspaces it
# owns (empty = no cap).
PLATFORM_MONTHLY_BUDGET_USD=
# Optional: articles one workspace may have queued or generating at once.
MAX_ACTIVE_GENERATIONS=20
# Optional: open = anyone can sign up; invite = only the first account and invited people.
SIGNUP_MODE=open
# none = password reset links and invitation emails are only logged; resend = send them.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=TriCity Writer <no-reply@example.com>
# With email delivery set up, new accounts must confirm their address before signing in.
REQUIRE_EMAIL_VERIFICATION=true

# Used by integration tests (packages/db, packages/core, apps/api). Tests are skipped when unset.
TEST_DATABASE_URL=postgres://localhost:5432/tricity_writer_test
