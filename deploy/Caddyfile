# Front door for the stack. SITE_ADDRESS is ":80" (plain HTTP on the server IP) or a domain such as
# app.example.com, for which Caddy obtains and renews a Let's Encrypt certificate automatically.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		# Browsers ignore HSTS on plain HTTP, so this only takes effect once a domain serves HTTPS. No
		# includeSubDomains: other subdomains (often the WordPress site itself) may not have HTTPS.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Auth, REST, MCP and OAuth discovery go straight to the API; everything else is the dashboard.
	@api path /api/* /mcp /mcp/* /.well-known/oauth-* /.well-known/openid-configuration*
	handle @api {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
